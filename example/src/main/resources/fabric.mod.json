{
    "schemaVersion": 1,
    "id": "${project.name}",
    "version": "${project.version}",
    "name": "${project.extra.display_name}",
    "description": "This is an example description! Tell everyone what your mod is about!",
    "accessWidener": "${project.name}.classtweaker",
    "authors": [
        "Me!"
    ],
    "contact": {
        "homepage": "https://fabricmc.net/",
        "sources": "https://github.com/FabricMC/fabric-example-mod"
    },
    "license": "CC0-1.0",
    "icon": "assets/${project.name}/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.example.example.TemplateMod"
        ],
        "client": [
            "com.example.example.client.TemplateModClient"
        ],
        "fabric-datagen": [
            "com.example.example.client.TemplateModDataGenerator"
        ]
    },
    "mixins": [
        "${project.name}.mixins.json",
        {
            "config": "${project.name}.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=${project.packages.fabric.version}",
        "minecraft": "~${project.packages.minecraft.version}",
        "java": ">=25",
        "fabric-api": "*"
    }
}